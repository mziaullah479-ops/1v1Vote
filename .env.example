# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required for the private /admin route.
# Keep this only in the hosting provider's secret settings, never in Git.
ADMIN_PASSWORD="CHANGE_ME"

# Public frontend origin allowed to call the API.
FRONTEND_ORIGIN="https://mziaullah479-ops.github.io"

# Set this during the static frontend build when the API is hosted separately.
VITE_BACKEND_URL="https://your-backend.example.com"
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_GTM_CONTAINER_ID="GTM-XXXXXXX"
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
VITE_ADSENSE_SLOT_HEADER_BANNER=""
VITE_ADSENSE_SLOT_IN_CONTENT=""
VITE_ADSENSE_SLOT_SIDEBAR=""
VITE_ADSENSE_SLOT_FOOTER_BANNER=""

# Manual match-request payments. Do not put private account secrets in Git.
PAYMENT_ACCOUNT_LABEL="Your approved payment account"
PAYMENT_INSTRUCTIONS="Send the selected plan amount through the approved account, then submit the transaction reference. Admin verifies payment before publishing."

# Persistent JSON database and local backup directory.
# These remain useful for local fallback and backups when Turso is configured.
DATA_DIR="./data"
BACKUP_DIR="./data/backups"

# Optional permanent-free Turso database for hosts without persistent disks.
# When both are set, Turso is authoritative and the JSON file is a local mirror.
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"
